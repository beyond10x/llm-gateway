{
  "name": "llm-gateway-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit && vue-tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.harness.json",
    "test": "vitest run",
    "e2e": "playwright test --project=gate",
    "ux:round": "node --experimental-strip-types --no-warnings ux/round.ts"
  },
  "dependencies": {
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=22.18"
  }
}
